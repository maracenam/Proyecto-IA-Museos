# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.

# --- Postgres local (docker compose) ---
POSTGRES_DB=observatorio
POSTGRES_USER=observatorio
POSTGRES_PASSWORD=observatorio
POSTGRES_PORT=5432

# Conexión que usa el pipeline. En local apunta al Postgres de docker compose;
# en producción, a la cadena de conexión de Supabase (Settings > Database).
DATABASE_URL=postgresql://observatorio:observatorio@localhost:5432/observatorio

# --- Supabase (Sprint 3: app y cola de revisión) ---
SUPABASE_URL=
# Clave pública (anon/publishable): solo lectura gracias a RLS. Es la única que usa la app pública.
SUPABASE_ANON_KEY=

# --- Extracción SURDOC ---
SURDOC_BASE_URL=https://www.surdoc.cl
# User-Agent identificable con un contacto real (requisito de respeto a la fuente).
SURDOC_USER_AGENT=ObservatorioSURDOC/0.1 (+https://github.com/maracenam/Proyecto-IA-Museos)
# Segundos mínimos entre solicitudes (máximo 1 cada 2 s).
SURDOC_PAUSA_SEGUNDOS=2

# --- Normalización con LLM local (Sprint 2) ---
# Proveedor del modelo: por ahora solo "ollama" (local, sin costo).
LLM_PROVEEDOR=ollama
OLLAMA_URL=http://localhost:11434
# Elegido en el Sprint 0 (docs/sprint0.md §6.2).
LLM_MODELO=gemma2:2b
